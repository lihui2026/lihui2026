Screen {
    background: $surface;
}

#main {
    height: 1fr;
    layout: vertical;
}

#chat-log {
    height: 1fr;
    overflow-y: auto;
    padding: 1 2;
    border: tall $primary;
}

#input-bar {
    height: auto;
    dock: bottom;
    padding: 1 2;
}

#user-input {
    width: 1fr;
}

#send-btn {
    width: auto;
}
